rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // وثيقة المستخدم: القراءة والكتابة فقط لصاحب الحساب
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // مجموعة المفضّلة: القواعد لا تتوارث للـ subcollections تلقائيًا
    match /users/{uid}/favorites/{productId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // أي مسار آخر: رفض افتراضي (سلوك Firestore الطبيعي)
  }
}
